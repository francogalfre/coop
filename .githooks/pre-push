#!/bin/sh
# Full test suite before code leaves the machine. Linting is pre-commit's job.

fail() { echo "pre-push: $*" >&2; exit 1; }
ran=0

if command -v go >/dev/null 2>&1; then
  for mod in $(find . -name go.mod -not -path './node_modules/*'); do
    dir=$(dirname "$mod")
    echo "pre-push: go test $dir"
    (cd "$dir" && go test ./...) || fail "go test failed in $dir"
    ran=1
  done
fi

if [ -f package.json ] && grep -q '"test"[[:space:]]*:' package.json; then
  if command -v bun >/dev/null 2>&1; then
    bun run test || fail "bun test failed"
    ran=1
  else
    echo "pre-push: bun not found, skipping TS tests"
  fi
fi

[ "$ran" = 0 ] && echo "pre-push: no tests configured yet, nothing to run"
exit 0
