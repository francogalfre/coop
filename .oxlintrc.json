{
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": [
    ".agents/",
    ".claude/",
    "**/dist/",
    "**/.next/",
    "**/.turbo/"
  ]
}
