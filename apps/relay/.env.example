COOP_RELAY_ADDR=:8787

DATABASE_URL=postgres://postgres:password@localhost:5432/coop?sslmode=require

# Comma-separated exact origins allowed for CORS and WebSocket upgrades.
COOP_WEB_ORIGINS=http://localhost:3000

# Where the relay reaches the web app to verify browser sessions. On a split
# deploy this is the web app's public URL.
COOP_WEB_INTERNAL_URL=http://localhost:3000

COOP_INTERNAL_SECRET=

COOP_GITHUB_CLIENT_ID=
COOP_GITHUB_CLIENT_SECRET=

# Full relay subdomain, used by apps/relay/docker-compose.yml (e.g. relay.example.com).
COOP_RELAY_DOMAIN=
