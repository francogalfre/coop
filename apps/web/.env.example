DATABASE_URL=postgres://postgres:password@localhost:5432/coop?uselibpqcompat=true&sslmode=require

COOP_GITHUB_CLIENT_ID=
COOP_GITHUB_CLIENT_SECRET=

COOP_INTERNAL_SECRET=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_COOP_RELAY_URL=http://localhost:8787

# Only when web and relay run on different subdomains: the shared parent domain,
# leading dot included (e.g. .example.com). Leave unset for a single-origin deploy.
COOP_COOKIE_DOMAIN=
