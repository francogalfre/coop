# Copy to .env and fill in, then: docker compose up -d --build
#
# Same-origin deployment: web and relay are both served from COOP_DOMAIN
# behind the Caddy reverse proxy (see deploy/Caddyfile), so the relay's
# SameSite=Lax session cookie (apps/relay/internal/auth/browser_session.go)
# works without a separate auth mechanism.

# Public domain the whole app is served from, e.g. coop.example.com
# (no scheme, no trailing slash — docker-compose.yml prefixes https://).
COOP_DOMAIN=

# Managed/external Postgres connection string (this deployment runs no
# Postgres container). Same variable name for both relay and web — they
# point at the same database.
DATABASE_URL=postgres://user:password@host:5432/coop?sslmode=require

# GitHub OAuth app credentials. Callback URL: https://${COOP_DOMAIN}/api/auth/callback/github
COOP_GITHUB_CLIENT_ID=
COOP_GITHUB_CLIENT_SECRET=

# Shared secret the relay and web use to authenticate server-to-server
# calls (relay -> web's /api/internal/* routes). Must match on both
# services — generate with: openssl rand -base64 32
COOP_INTERNAL_SECRET=

# Better Auth's signing secret (web only). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
